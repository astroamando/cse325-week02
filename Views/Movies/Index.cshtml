
@model IEnumerable<MvcMovie.Models.Movie>

@{
    ViewData["Title"] = "Scott's Movie Collection";
}

<h1>Scott's Movie Collection</h1>

<form asp-controller="Movies" asp-action="Index" method="get" class="mb-3">
    <label for="releaseYear" class="form-label">
        Show movies released in or after:
    </label>

    <div class="d-flex gap-2">
        <input type="number"
               id="releaseYear"
               name="releaseYear"
               min="1888"
               max="2100"
               value="@ViewData["ReleaseYear"]"
               class="form-control"
               placeholder="Enter year (e.g., 2000)" />

        <button type="submit" class="btn btn-primary">
            Filter
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Show All
        </a>
    </div>
</form>

<p>
    <a asp-action="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ReleaseDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Genre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Price)
            </th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Title)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ReleaseDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Genre)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Price)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
